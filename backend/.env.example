# Backend settings (all optional)
# Copy to .env if you need to override defaults.

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Maximum upload size in megabytes
MAX_UPLOAD_MB=500

# Gemini model used for audio transcription + translation
GEMINI_MODEL=gemini-2.5-flash

# Speed-up ceiling used for duration sync
MAX_ATEMPO=1.35

# Parallel Edge TTS connections (lower is gentler on Microsoft's endpoint)
EDGE_TTS_CONCURRENCY=2
# Attempts per clip and base backoff for Edge TTS "No audio received" blips
EDGE_TTS_ATTEMPTS=6
EDGE_TTS_RETRY_DELAY=1.2

# Font used when burning Khmer subtitles (install this font on Windows)
SUBTITLE_FONT=Kantumruy Pro

# Optional custom subtitle style (libass force_style syntax)
# SUBTITLE_STYLE=FontName=Kantumruy Pro,BorderStyle=4,BackColour=&H80000000,Outline=1,Shadow=0,MarginV=30

# --- Free AI Voice Clone ------------------------------------------------------
# Enable the Seed-VC voice-clone mode in the UI
VOICE_CLONE_ENABLED=1

# Custom reference upload rules (seconds)
REFERENCE_MIN_SECONDS=5
REFERENCE_MAX_SECONDS=15

# Auto-extracted reference window (seconds)
REFERENCE_WINDOW_SECONDS=11

# Vocal isolation. Demucs needs `pip install -r requirements-voice-clone.txt`;
# without it the backend uses the FFmpeg vocal bandpass fallback.
DEMUCS_MODEL=htdemucs
AUDIO_SEPARATOR_MODEL=UVR-MDX-NET-Inst_HQ_3.onnx

# Seed-VC. Default: public Gradio Space. Requires `gradio_client`.
SEEDVC_SPACE=Plachta/Seed-VC
SEEDVC_API_NAME=/predict_1
SEEDVC_DIFFUSION_STEPS=25
SEEDVC_CFG_RATE=0.7
SEEDVC_CONCURRENCY=2

# Optional Hugging Face token (more ZeroGPU quota for the public Space)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxx

# Or point at a local Seed-VC checkout instead of the Space:
# SEEDVC_LOCAL_DIR=C:\tools\seed-vc
# SEEDVC_CHECKPOINT=C:\tools\seed-vc\checkpoints\model_1.pth

